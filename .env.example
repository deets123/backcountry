# Copy to .env (git-ignored) and edit. Never commit .env.
# Chat model: ollama:<model name from `ollama list`>
BACKCOUNTRY_LLM=ollama:qwen3:14b
OLLAMA_URL=http://127.0.0.1:11434
# For Claude models later (not used yet):
# ANTHROPIC_API_KEY=
# Park notices (permits, closures, fees) from the National Park Service data service. A key is free:
# https://www.nps.gov/subjects/developer/get-started.htm (DEMO_KEY works for a first try, 30 requests an hour).
# Without it the app says park notices aren't set up and shows only what OpenStreetMap tags say.
BACKCOUNTRY_NPS_API_KEY=
